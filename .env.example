# Production (Vercel): Turso дерекқоры. Мәндерін Vercel → Settings → Environment Variables бөліміне қойыңыз,
# бұл файлға немесе GitHub-қа ешқашан жазбаңыз.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Организатор кабинетінің PIN-коды (4–12 цифр). Тек серверде тексеріледі.
# Мәнін Vercel → Settings → Environment Variables бөліміне қойыңыз, GitHub-қа жазбаңыз.
ORGANIZER_PIN=

# Жергілікті іске қосу: TURSO_DATABASE_URL бос болса, деректер data/qadam.sqlite файлына жазылады.
PORT=3000
# HTTPS арқылы жұмыс істегенде 1 қойыңыз (Vercel-де өзі қосылады)
COOKIE_SECURE=0
# Reverse proxy (nginx, Render т.б.) артында болса: TRUST_PROXY=1
# DATA_DIR=data
